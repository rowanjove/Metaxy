{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "drop.example.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocket-relay",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "pocket-relay-images"
    }
  ],
  "vars": {
    "APP_NAME": "PocketRelay",
    "ARCHIVE_RETENTION_HOURS": "72",
    "COOLING_AFTER_HOURS": "24",
    "MAX_IMAGE_BYTES": "10485760"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
