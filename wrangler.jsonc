{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "3c26e711426605a859980743a286e21f",
  "name": "metaxy",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "drop.rowanjove.top",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/d/*",
      "/i/*",
      "/dav",
      "/dav/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocket-relay",
      "database_id": "ffa68a4e-530a-426b-9efb-fbabf5ac5b7c",
      "migrations_dir": "./migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pocket-relay-files"
    },
    {
      "binding": "DRIVE",
      "bucket_name": "pocket-relay-drive"
    },
    {
      "binding": "GALLERY",
      "bucket_name": "pocket-relay-gallery"
    }
  ],

  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RETRIEVE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "DRIVE_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "DAV_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 240, "period": 60 }
    }
  ],

  "vars": {
    "APP_NAME": "之间门",
    "UPLOAD_MODE": "token",
    "MAX_FILE_BYTES_HARD": "52428800",
    "MAX_DROP_FILE_BYTES_HARD": "524288000",
    "MAX_TEXT_BYTES_HARD": "5242880",
    "MAX_FILES_PER_DROP_HARD": "10",
    "PRESIGNED_URL_TTL_SECONDS": "300",
    "R2_BUCKET_NAME": "pocket-relay-files",
    "DRIVE_ENABLED": "true",
    "DRIVE_BUCKET_NAME": "pocket-relay-drive",
    "GALLERY_BUCKET_NAME": "pocket-relay-gallery",
    "DAV_USERNAME": "admin",
    "DRIVE_MAX_FILE_BYTES_HARD": "52428800",
    "DAV_MAX_FILE_BYTES_HARD": "52428800"
  },

  "triggers": {
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
