{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-relay",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/d/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocket-relay",
      "database_id": "33e30baf-0a6c-4336-9da6-51f6f4a27fa2",
      "migrations_dir": "./migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pocket-relay-files"
    }
  ],

  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RETRIEVE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "vars": {
    "APP_NAME": "PocketRelay",
    "UPLOAD_MODE": "token",
    "MAX_FILE_BYTES_HARD": "52428800",
    "MAX_DROP_FILE_BYTES_HARD": "524288000",
    "MAX_TEXT_BYTES_HARD": "5242880",
    "MAX_FILES_PER_DROP_HARD": "10",
    "PRESIGNED_URL_TTL_SECONDS": "300",
    "R2_BUCKET_NAME": "pocket-relay-files"
  },

  "triggers": {
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
